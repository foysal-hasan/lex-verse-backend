// ==================== ENUMS ====================

enum AttemptStatus {
  in_progress
  submitted
  auto_submitted
}

enum WrittenSubmissionStatus {
  pending_evaluation
  evaluated
  resubmission_requested
}

// ==================== MCQ ATTEMPTS & ANSWERS ====================
enum AttemptMode {
  live
  archived
}

model ExamAttempt {
  id           String        @id @default(uuid())
  user_id      String
  exam_id      String
  status       AttemptStatus @default(in_progress)
  started_at   DateTime      @default(now()) @db.Timestamptz
  expires_at   DateTime      @db.Timestamptz
  submitted_at DateTime?     @db.Timestamptz
  mode         AttemptMode     @default(archived)

  package_id   String       

  exam               Exam               @relation(fields: [exam_id], references: [id], onDelete: Cascade)
  user               User               @relation(fields: [user_id], references: [id], onDelete: Cascade)
  package      Package       @relation(fields: [package_id], references: [id], onDelete: Cascade)
  answers            UserAnswer[]
  written_submission WrittenSubmission?
  exam_result     ExamResult?


  @@index([user_id], map: "idx_exam_attempts_user_id")
  @@index([exam_id], map: "idx_exam_attempts_exam_id")
  @@map("exam_attempts")
}

model UserAnswer {
  id                 String @id @default(uuid())
  attempt_id         String
  question_id        String
  selected_option_id String // Relational ID pointing to the Option model

  attempt         ExamAttempt @relation(fields: [attempt_id], references: [id], onDelete: Cascade)
  question        Question    @relation(fields: [question_id], references: [id], onDelete: Cascade)
  selected_option Option      @relation(fields: [selected_option_id], references: [id], onDelete: Cascade)
  created_at      DateTime    @default(now()) @db.Timestamptz

  // 🔒 Natively enforces that a question can only have one saved answer per attempt
  @@unique([attempt_id, question_id])
  @@map("user_answers")
}

// ==================== WRITTEN EXAM SUBMISSIONS & WORKFLOWS ====================

model WrittenSubmission {
  id         String @id @default(uuid())
  exam_id    String
  package_id String
  user_id    String
  attempt_id String @unique // 🔒 1-to-1 link to the active attempt session

  file_path      String?
  file_mime_type String?
  text_answer    String? @db.Text

  status         WrittenSubmissionStatus @default(pending_evaluation)
  marks_obtained Decimal?
  feedback       String?                 @db.Text

  evaluated_by String?
  submitted_at DateTime @default(now()) @db.Timestamptz
  updated_at   DateTime @updatedAt @db.Timestamptz

  exam      Exam        @relation(fields: [exam_id], references: [id], onDelete: Cascade)
  package   Package     @relation(fields: [package_id], references: [id], onDelete: Cascade)
  user      User        @relation(name: "UserWrittenSubmissions", fields: [user_id], references: [id], onDelete: Cascade)
  evaluator User?       @relation(name: "UserReviewedSubmissions", fields: [evaluated_by], references: [id], onDelete: SetNull)
  attempt   ExamAttempt @relation(fields: [attempt_id], references: [id], onDelete: Cascade)

  @@index([exam_id], map: "idx_written_submissions_exam_id")
  @@index([user_id], map: "idx_written_submissions_user_id")
  @@map("written_submissions")
}

model WrittenExamResubmissionRequest {
  id          String   @id @default(uuid())
  exam_id     String
  user_id     String
  reason      String   @db.Text
  is_approved Boolean  @default(false)
  created_at  DateTime @default(now()) @db.Timestamptz

  exam Exam @relation(fields: [exam_id], references: [id], onDelete: Cascade)
  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("written_exam_resubmission_requests")
}

model WrittenExamResubmissionAccess {
  id         String   @id @default(uuid())
  exam_id    String
  user_id    String
  granted_by String?
  created_at DateTime @default(now()) @db.Timestamptz

  exam    Exam  @relation(fields: [exam_id], references: [id], onDelete: Cascade)
  user    User  @relation(fields: [user_id], references: [id], onDelete: Cascade)
  granter User? @relation(name: "resubmission_granter", fields: [granted_by], references: [id], onDelete: SetNull)

  @@map("written_exam_resubmission_accesses")
}

model WrittenExamAllowedUser {
  id      String @id @default(uuid())
  exam_id String
  user_id String

  exam Exam @relation(fields: [exam_id], references: [id], onDelete: Cascade)
  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([exam_id, user_id])
  @@map("written_exam_allowed_users")
}
