// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

generator client_js {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// =============== User Start ===============
enum UserRole {
  user
  mentor
  admin
}

enum UserStatus {
  ACTIVE
  BLOCKED
  SUSPENDED
}

model User {
  id         String   @id @default(uuid())
  created_at DateTime @default(now()) @db.Timestamptz
  updated_at DateTime @updatedAt @db.Timestamptz

  name       String
  email      String     @unique
  password   String
  avatar_url String?
  role       UserRole   @default(user)
  status     UserStatus @default(ACTIVE)

  phone      String?
  university String?
  profession String? @default("student")
  gender     String?
  year_level Int     @default(0)

  email_verified_at DateTime? @db.Timestamptz

  // for system users
  designation String?
  credential  String?
  bio         String? @db.Text
  facebook    String?
  twitter     String?
  instagram   String?
  linkedin    String?

  mentor_ratings_given    MentorRating[]        @relation("UserRatings")
  mentor_ratings_recv     MentorRating[]        @relation("MentorRatings")
  roadmap_progress        UserRoadmapProgress[]
  responses               Response[]
  created_announcements   Announcement[]
  user_notifications      UserNotification[]
  notifications           Notification[]
  weakness_stats          UserWeaknessStat[]
  created_flashcard_decks FlashcardDeck[]       @relation("CreatedFlashcardDecks")
  study_group_members     StudyGroupMember[]
  study_group_messages    StudyGroupMessage[]
  favorites               Favorite[]
  bar_favorites           BarFavorite[]

  package_requests         PackageAccessRequest[] @relation("UserPackageRequests")
  decided_package_requests PackageAccessRequest[] @relation("DecidedByAdmin")

  push_prompt_events   PushPromptEvent[]
  user_sessions        UserSession[]
  user_unlocks         UserUnlock[]
  bar_responses        BarResponse[]
  score_histories      UserScoreHistory[]
  bar_score_histories  BarUserScoreHistory[]
  created_study_groups StudyGroup[]
  package_accesses     UserPackageAccess[]   @relation("UserPackageAccesses")
  granted_accesses     UserPackageAccess[]   @relation("GrantedByAdmin")
  revoked_accesses     UserPackageAccess[]   @relation("RevokedByAdmin")

  subscriptions                      UserSubscription[]
  articles                           Article[]
  testimonials                       Testimonial[]
  fcm_tokens                         FcmToken[]
  push_preference                    PushPreference?
  push_logs                          PushLog[]
  chatbot_rate_limits                ChatbotRateLimit[]
  course_enrollments                 CourseEnrollment[]
  course_lesson_progress             CourseLessonProgress[]
  account_deletions                  AccountDeletion[]
  account_deletion_attempt           AccountDeletionAttempt?
  bar_written_submissions            BarWrittenSubmission[]
  note_purchases                     NotePurchase[]
  quiz_retake_requests               QuizRetakeRequest[]
  chatbot_sessions                   ChatbotSession[]
  chatbot_messages                   ChatbotMessage[]
  written_exam_resubmission_accesses WrittenExamResubmissionAccess[]
  quiz_allowed_users                 QuizAllowedUser[]
  written_exam_allowed_users         WrittenExamAllowedUser[]
  download_events                    DownloadEvent[]
  written_submissions                WrittenSubmission[]              @relation("UserWrittenSubmissions")
  reviewed_submissions               WrittenSubmission[]              @relation("UserReviewedSubmissions")
  written_exam_resubmission_requests WrittenExamResubmissionRequest[]

  created_exams      Exam[]                          @relation("created_exams")
  deleted_exams      Exam[]                          @relation("deleted_exams")
  exam_attempts      ExamAttempt[]
  graded_submissions WrittenExamResubmissionAccess[] @relation("resubmission_granter")
  exam_results    ExamResult[]

  @@map("users")
}

model UserSession {
  id         String   @id @default(cuid())
  created_at DateTime @default(now()) @db.Timestamptz
  updated_at DateTime @updatedAt @db.Timestamptz

  user_id     String
  user        User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  device_name String
  ip_address  String
  expires_at  DateTime @db.Timestamptz

  @@map("user_sessions")
}

model AccountDeletion {
  id         String   @id @default(uuid())
  user_id    String
  email_hash String
  reason     String?
  ip_hash    String?
  user_agent String?
  deleted_at DateTime @default(now()) @db.Timestamptz

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("account_deletions")
}

model AccountDeletionAttempt {
  user_id         String   @id
  last_attempt_at DateTime @default(now()) @db.Timestamptz
  attempt_count   Int      @default(1)

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("account_deletion_attempts")
}

// ================ User end ======================

// =============== Package start ==================
// PackageContentRule Model (Rules for mapping content resources to packages)
model PackageContentRule {
  id            String  @id @default(uuid())
  package_id    String
  resource_type String
  match_mode    String
  match_value   Json    @default("{}") @db.JsonB
  label         String?

  // Relations
  package Package @relation(fields: [package_id], references: [id], onDelete: Cascade)

  @@index([package_id, resource_type], map: "idx_pcr_pkg_type")
  @@map("package_content_rules")
}

enum PkgDuration {
  monthly
  m3
  m6
  y1
  y2
  y3
}

enum PkgKind {
  batch
  free
  duration
}

enum PkgProgram {
  bjs
  bar
  llb
}

enum PkgTrack {
  preliminary
  written
}

// Package Model
model Package {
  id                             String       @id @default(uuid())
  program                        PkgProgram
  track                          PkgTrack?
  kind                           PkgKind
  duration                       PkgDuration?
  title                          String
  subtitle                       String?
  batch_number                   Int?
  is_active                      Boolean      @default(true)
  is_coming_soon                 Boolean      @default(false)
  sort_order                     Int          @default(0)
  batch_started_at               DateTime?    @db.Timestamptz
  batch_ended_at                 DateTime?    @db.Timestamptz
  batch_locks_new_only           Boolean      @default(true)
  details_json                   Json?        @default("{}") @db.JsonB
  created_at                     DateTime     @default(now()) @db.Timestamptz
  updated_at                     DateTime     @updatedAt @db.Timestamptz
  details_html                   String?
  allow_program_routine_fallback Boolean      @default(true)
  includes_all_notes             Boolean      @default(false)
  includes_all_qbanks            Boolean      @default(false)
  includes_all_premium           Boolean      @default(false)
  price                          Decimal?     @default(0)
  discount_price                 Decimal?     @default(0)

  announcements           Announcement[]
  responses               Response[]
  bar_responses           BarResponse[]
  score_histories         UserScoreHistory[]
  bar_score_histories     BarUserScoreHistory[]
  content_rules           PackageContentRule[]
  access_requests         PackageAccessRequest[]
  user_accesses           UserPackageAccess[]
  bar_written_submissions BarWrittenSubmission[]
  written_submissions     WrittenSubmission[]
  question_banks          QuestionBank[]
  book_references         BookReference[]
  suggestions             Suggestions[]
  notes                   Note[]
  syllabuses              Syllabus[]
  routines                Routine[]
  package_exams           PackageExam[]
  exam_attempts         ExamAttempt[]
  exam_results          ExamResult[]

  @@map("packages")
}

// Custom Enum for Package Access Request Status
enum PkgReqStatus {
  pending
  approved
  rejected
  cancelled
}

// PackageAccessRequest Model (Manual bKash/Payment Request for Packages)
model PackageAccessRequest {
  id             String  @id @default(uuid())
  user_id        String
  package_id     String
  name           String
  phone          String
  transaction_id String
  message        String?

  payment_method String

  status              PkgReqStatus @default(pending)
  decided_by          String?
  decided_at          DateTime?    @db.Timestamptz
  decision_note       String?
  client_request_uuid String?      @unique
  created_at          DateTime     @default(now()) @db.Timestamptz

  // Relations
  user            User    @relation("UserPackageRequests", fields: [user_id], references: [id])
  package         Package @relation(fields: [package_id], references: [id])
  decided_by_user User?   @relation("DecidedByAdmin", fields: [decided_by], references: [id])

  granted_accesses UserPackageAccess[]

  @@map("package_access_requests")
}

// Custom Enum for Package Access Status
enum PkgAccStatus {
  active
  expired
  revoked
}

// UserPackageAccess Model (Tracks user package access & subscription lifecycle)
model UserPackageAccess {
  id            String       @id @default(uuid())
  user_id       String
  package_id    String
  request_id    String?
  granted_by    String?
  granted_at    DateTime?    @default(now()) @db.Timestamptz
  starts_at     DateTime     @default(now()) @db.Timestamptz
  expires_at    DateTime?    @db.Timestamptz
  status        PkgAccStatus @default(active)
  revoked_by    String?
  revoked_at    DateTime?    @db.Timestamptz
  revoke_reason String?

  // Relations
  user            User                  @relation("UserPackageAccesses", fields: [user_id], references: [id])
  package         Package               @relation(fields: [package_id], references: [id])
  request         PackageAccessRequest? @relation(fields: [request_id], references: [id])
  granted_by_user User?                 @relation("GrantedByAdmin", fields: [granted_by], references: [id])
  revoked_by_user User?                 @relation("RevokedByAdmin", fields: [revoked_by], references: [id])

  @@unique([user_id, package_id], map: "user_package_access_user_pkg_unique")
  @@index([user_id, status], map: "idx_upa_user_status")
  @@map("user_package_access")
}

model PackageAuditLog {
  id          String    @id @default(uuid())
  actor_id    String?
  action      String
  target_type String?
  target_id   String?
  meta        Json?     @default("{}") @db.JsonB
  created_at  DateTime? @default(now()) @db.Timestamptz

  @@map("package_audit_log")
}

model PackageEvent {
  id         BigInt    @id @default(autoincrement())
  user_id    String?
  package_id String?
  event      String
  meta       Json?     @default("{}") @db.JsonB
  created_at DateTime? @default(now()) @db.Timestamptz

  @@index([package_id, event, created_at(sort: Desc)], map: "idx_pkg_events_lookup")
  @@map("package_events")
}

model PackageGrantAudit {
  id              String    @id @default(uuid())
  grant_id        String
  package_id      String
  user_id         String
  action          String
  actor_id        String?
  reason          String?
  prev_expires_at DateTime? @db.Timestamptz
  new_expires_at  DateTime? @db.Timestamptz
  created_at      DateTime  @default(now()) @db.Timestamptz

  @@index([grant_id], map: "idx_pga_grant")
  @@index([user_id], map: "idx_pga_user")
  @@index([package_id], map: "idx_pga_pkg")
  @@map("package_grant_audit")
}

// UserUnlock Model (Tracks unlocked premium items by users)
model UserUnlock {
  id           String   @id @default(uuid())
  user_id      String
  item_type    String
  item_id      String
  tokens_spent Int
  created_at   DateTime @default(now()) @db.Timestamptz

  // Relations
  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, item_type, item_id], map: "user_unlocks_user_id_item_type_item_id_key")
  @@index([user_id], map: "idx_user_unlocks_user_id")
  @@index([item_type, item_id], map: "idx_user_unlocks_item")
  @@map("user_unlocks")
}

// =============== Package end

// =============== Syllabus start ===============
model Syllabus {
  id         String   @id @default(uuid())
  created_at DateTime @default(now()) @db.Timestamptz
  updated_at DateTime @updatedAt @db.Timestamptz

  title          String
  track          PkgTrack?
  content        String?   @db.Text
  file_path      String?
  file_mime_type String?
  is_published   Boolean   @default(false)

  // relations
  packages Package[]

  @@map("syllabuses")
}

// =============== Syllabus end ===============

// =============== Routine start ===============

model Routine {
  id         String   @id @default(uuid())
  created_at DateTime @default(now()) @db.Timestamptz
  updated_at DateTime @updatedAt @db.Timestamptz

  program_type   PkgProgram
  track          PkgTrack?
  routine_type   String
  routine_number String?
  exam_date      DateTime?  @db.Timestamptz
  academic_year  Int?
  session_label  String?
  title          String
  description    String?
  file_mime_type String?
  file_path      String?
  is_published   Boolean    @default(false)
  is_pinned      Boolean    @default(false)

  created_by String?

  package_id    String?
  package       Package?      @relation(fields: [package_id], references: [id], onDelete: SetNull)
  package_exams PackageExam[]

  @@map("routines")
}

// =============== Routine end ===============

// RoadmapStage Model (Stages/Levels within a Roadmap)
model RoadmapStage {
  id          String    @id @default(uuid())
  title       String
  description String?
  order_index Int       @default(0)
  year_level  Int
  icon        String?   @default("school")
  is_active   Boolean?  @default(true)
  created_at  DateTime? @default(now()) @db.Timestamptz
  updated_at  DateTime? @default(now()) @db.Timestamptz
  deleted_at  DateTime? @db.Timestamptz
  deleted_by  String?

  // Relations
  modules RoadmapModule[]

  @@index([year_level, order_index], map: "idx_roadmap_stages_order")
  @@index([deleted_at], map: "idx_roadmap_stages_deleted_at")
  @@map("roadmap_stages")
}

// RoadmapModule Model (Modules within a Roadmap Stage)
model RoadmapModule {
  id               String    @id @default(uuid())
  stage_id         String
  title            String
  description      String?
  content_type     String?   @default("text")
  content_url      String?
  content_text     String?
  order_index      Int       @default(0)
  duration_minutes Int?      @default(0)
  is_active        Boolean?  @default(true)
  created_at       DateTime? @default(now()) @db.Timestamptz
  updated_at       DateTime? @default(now()) @db.Timestamptz
  deleted_at       DateTime? @db.Timestamptz
  deleted_by       String?

  // Relations
  stage         RoadmapStage          @relation(fields: [stage_id], references: [id], onDelete: Cascade)
  user_progress UserRoadmapProgress[]

  @@index([stage_id, order_index], map: "idx_roadmap_modules_stage")
  @@index([deleted_at], map: "idx_roadmap_modules_deleted_at")
  @@map("roadmap_modules")
}

// UserRoadmapProgress Model (Tracks user progress for each roadmap module)
model UserRoadmapProgress {
  id           String    @id @default(uuid())
  user_id      String
  module_id    String
  status       String?   @default("not_started")
  completed_at DateTime? @db.Timestamptz
  created_at   DateTime? @default(now()) @db.Timestamptz
  updated_at   DateTime? @default(now()) @db.Timestamptz

  // Relations
  user   User          @relation(fields: [user_id], references: [id], onDelete: Cascade)
  module RoadmapModule @relation(fields: [module_id], references: [id], onDelete: Cascade)

  @@unique([user_id, module_id], map: "user_roadmap_progress_user_id_module_id_key")
  @@index([user_id], map: "idx_user_roadmap_progress_user")
  @@map("user_roadmap_progress")
}

model MentorProfile {
  id                  String   @id @default(uuid())
  user_id             String
  specialization      String?
  bio                 String?
  availability_status String?  @default("available")
  created_at          DateTime @default(now()) @db.Timestamptz
  subjects            String[] @default([])

  queries MentorQuery[]

  @@map("mentor_profiles")
}

model MentorQuery {
  id                String    @id @default(uuid())
  user_id           String
  mentor_id         String?
  subject           String
  message           String
  status            String?   @default("open")
  created_at        DateTime? @default(now()) @db.Timestamptz
  priority          String?   @default("normal")
  subject_tag       String?
  first_response_at DateTime? @db.Timestamptz

  mentor  MentorProfile? @relation(fields: [mentor_id], references: [id], onDelete: SetNull)
  replies MentorReply[]

  @@index([user_id], map: "idx_mentor_queries_user")
  @@map("mentor_queries")
}

model MentorReply {
  id         String    @id @default(uuid())
  query_id   String
  sender_id  String
  message    String
  created_at DateTime? @default(now()) @db.Timestamptz

  query MentorQuery @relation(fields: [query_id], references: [id], onDelete: Cascade)

  @@index([query_id], map: "idx_mentor_replies_query")
  @@map("mentor_replies")
}

model MentorRating {
  id         String   @id @default(uuid())
  created_at DateTime @default(now()) @db.Timestamptz
  updated_at DateTime @updatedAt @db.Timestamptz

  query_id  String
  user_id   String
  mentor_id String
  rating    Int
  comment   String?

  user   User @relation("UserRatings", fields: [user_id], references: [id], onDelete: Cascade)
  mentor User @relation("MentorRatings", fields: [mentor_id], references: [id], onDelete: Cascade)

  // Constraints
  @@unique([query_id, user_id], name: "query_user_rating_unique")
  @@map("mentor_ratings")
}

model University {
  id         String   @id @default(uuid())
  name       String
  type       String?  @default("other")
  created_at DateTime @default(now()) @db.Timestamptz

  @@map("universities")
}

model Quiz {
  id           String  @id @default(uuid())
  title        String?
  program_type String? @default("general")

  description          String?
  time_limit           Int?
  created_by           String?
  created_at           DateTime @default(now()) @db.Timestamptz
  status               String?  @default("upcoming")
  has_negative_marking Boolean? @default(false)
  allow_answer_change  Boolean  @default(false)
  negative_mark_value  Decimal  @default(0.25)

  exam_type            String?   @default("preliminary")
  live_start_time      DateTime? @db.Timestamptz
  live_end_time        DateTime? @db.Timestamptz
  is_premium           Boolean?  @default(false)
  archive_pdf_url      String?
  subject_tag          String?
  prerequisite_quiz_id String?
  program_types        String[]  @default(["bjs"])
  subject_category     String?
  total_questions      Int?
  total_marks          Decimal?
  cut_mark_percent     Decimal?
  exam_date            DateTime? @db.Timestamptz
  syllabus_no          String?
  updated_at           DateTime  @default(now()) @db.Timestamptz
  deleted_at           DateTime? @db.Timestamptz
  deleted_by           String?
  batch_title          String?
  batch_number         Int?
  access_type          String    @default("open")
  reminder_sent_at     DateTime? @db.Timestamptz
  exam_track           String?
  routine_no           String?
  instructions         String?
  access_mode          String    @default("public")
  is_free_demo         Boolean?  @default(false)

  // Self-relation
  prerequisite_quiz       Quiz?                  @relation("QuizPrerequisites", fields: [prerequisite_quiz_id], references: [id], onDelete: SetNull)
  prerequisite_for        Quiz[]                 @relation("QuizPrerequisites")
  bar_written_submissions BarWrittenSubmission[]
  daily_tasks             DailyTask[]
  exam_archive_pdf        ExamArchivePdf?

  // relations
  quiz_retake_requests   QuizRetakeRequest[]
  quiz_allowed_users     QuizAllowedUser[]
  bar_responses          BarResponse[]
  // written_submissions    WrittenSubmission[]
  responses              Response[]
  user_score_history     UserScoreHistory[]
  bar_user_score_history BarUserScoreHistory[]

  @@index([exam_type, exam_track], map: "idx_quizzes_exam_type_track")
  @@index([program_type, exam_type], map: "idx_quizzes_program_exam")
  @@index([live_start_time, live_end_time], map: "idx_quizzes_live_window")
  @@index([program_types], type: Gin, map: "idx_quizzes_program_types")
  @@index([deleted_at], map: "idx_quizzes_deleted_at")
  @@index([access_type], map: "idx_quizzes_access_type")
  @@map("quizzes")
}

model QuizAllowedUser {
  id         String   @id @default(uuid())
  quiz_id    String
  user_id    String
  granted_by String?
  granted_at DateTime @default(now()) @db.Timestamptz

  quiz Quiz @relation(fields: [quiz_id], references: [id], onDelete: Cascade)
  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([quiz_id, user_id], map: "quiz_allowed_users_quiz_id_user_id_key")
  @@index([user_id], map: "idx_qau_user")
  @@index([quiz_id], map: "idx_qau_quiz")
  @@index([quiz_id, user_id], map: "idx_qau_quiz_user")
  @@map("quiz_allowed_users")
}

// Question Model
model MCQQuestion {
  id         String   @id @default(uuid())
  created_at DateTime @default(now()) @db.Timestamptz
  updated_at DateTime @updatedAt @db.Timestamptz

  question_text           String?
  question_file_path      String?
  question_file_mime_type String?
  // options           Option[]

  correct_answer             String
  explanation_text           String? @db.Text
  explanation_math           String? @db.Text
  explanation_file_path      String?
  explanation_file_mime_type String?

  created_by String?

  deleted_at DateTime? @db.Timestamptz
  deleted_by String?

  @@index([deleted_at], map: "idx_questions_deleted_at")
  @@map("mcq_questions")
}

