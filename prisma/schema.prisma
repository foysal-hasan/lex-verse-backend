enum ExamFormat {
  MCQ
  WRITTEN
}

model Question {
  id         String   @id @default(uuid())
  created_at DateTime @default(now()) @db.Timestamptz
  updated_at DateTime @updatedAt @db.Timestamptz

  // Discriminator to define if it's an MCQ or Written question
  format ExamFormat

  // Common Question Fields
  question_text           String
  question_file_path      String?
  question_file_mime_type String?

  // --- MCQ Specific Fields (Null if format is WRITTEN) ---
  options                    Option[]
  correct_answer             String?
  explanation_text           String?  @db.Text
  explanation_math           String?  @db.Text
  explanation_file_path      String?
  explanation_file_mime_type String?

  // --- Written Exam Specific Fields (Null if format is MCQ) ---
  marks      Decimal? @default(10)
  guidelines String?  @db.Text

  // Metadata & Soft Deletes
  created_by String?
  deleted_at DateTime? @db.Timestamptz
  deleted_by String?

  // Relations matching your requirement: Question -> QuestionSet
  question_sets QuestionSet[]

  user_answers UserAnswer[]

  @@index([deleted_at], map: "questions_deleted_at_idx")
  @@map("questions")
}

model Option {
  id          String   @id @default(cuid())
  question_id String
  question    Question @relation(fields: [question_id], references: [id], onDelete: Cascade)

  option_key  String? // e.g., "A", "B", "C", "D"
  option_text String

  // Relations
  user_answers UserAnswer[]

  @@index([question_id])
  @@map("options")
}

model QuestionSet {
  id         String   @id @default(uuid())
  created_at DateTime @default(now()) @db.Timestamptz
  updated_at DateTime @default(now()) @db.Timestamptz

  title       String
  program     PkgProgram
  track       PkgTrack
  description String?    @db.Text

  // Relations
  questions Question[]
  exams     Exam[]

  @@map("question_sets")
}


model ExamResult {
  id                String       @id @default(uuid())
  attempt_id        String       @unique
  user_id           String
  exam_id           String
  package_id        String
  
  exam_format       ExamFormat   
  total_marks       Float        @default(0)
  obtained_marks    Float?       
  is_graded         Boolean      @default(true) 
  percentage        Float?       

  // MCQ Specific Metrics (Nullable for Written Exams)
  total_questions   Int?
  right_count       Int?
  wrong_count       Int?
  unanswered_count  Int?

  // Written Specific Metrics
  teacher_feedback  String?      @db.Text

  submitted_at      DateTime     @default(now()) @db.Timestamptz

  attempt           ExamAttempt  @relation(fields: [attempt_id], references: [id], onDelete: Cascade)
  user              User         @relation(fields: [user_id], references: [id], onDelete: Cascade)
  exam              Exam         @relation(fields: [exam_id], references: [id], onDelete: Cascade)
  package           Package      @relation(fields: [package_id], references: [id], onDelete: Cascade)

  @@index([user_id, package_id], map: "idx_exam_results_user_package")
  @@index([exam_id], map: "idx_exam_results_exam")
  @@map("exam_results")
}

enum ResubmissionProgram {
  bjs
  bar
}

enum ResubmissionStatus {
  pending
  approved
  rejected
  consumed
  expired
  revoked
}

model BarWrittenSubmission {
  id                      String    @id @default(uuid())
  user_id                 String
  exam_id                 String?
  quiz_id                 String?
  question_id             String?
  answer_text             String?
  file_url                String?
  file_type               String?   @default("text")
  status                  String    @default("pending")
  score                   Decimal?  @default(0) @db.Decimal
  feedback                String?
  reviewed_by             String?
  reviewed_at             DateTime? @db.Timestamptz
  submitted_at            DateTime  @default(now()) @db.Timestamptz
  created_at              DateTime  @default(now()) @db.Timestamptz
  feedback_breakdown      Json?     @db.JsonB
  resubmission_request_id String?
  submission_cycle        Int       @default(1) // smallint
  prior_evaluations       Json?     @db.JsonB
  package_id              String?

  user    User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  package Package? @relation(fields: [package_id], references: [id], onDelete: SetNull)
  quiz    Quiz?    @relation(fields: [quiz_id], references: [id], onDelete: Cascade)

  @@unique([user_id, exam_id, package_id], map: "uniq_bar_written_sub_doc")
  @@index([user_id, exam_id, package_id], map: "bar_ws_user_exam_pkg_idx")
  @@index([exam_id, package_id], map: "bar_ws_exam_pkg_idx")
  @@index([user_id, exam_id], map: "idx_bar_ws_user_exam")
  @@index([exam_id], map: "idx_bar_ws_exam")
  @@index([status], map: "idx_bar_ws_status")
  @@index([user_id, package_id], map: "idx_bar_written_subs_user_pkg")
  @@index([resubmission_request_id], map: "idx_bws_resub_req")
  @@map("bar_written_submissions")
}

model DailyTask {
  id         String    @id @default(uuid())
  day_index  Int
  quiz_id    String
  unlock_at  DateTime? @db.Timestamptz
  program    String    @default("llb")
  created_at DateTime  @default(now()) @db.Timestamptz
  year_level Int       @default(1)
  deleted_at DateTime? @db.Timestamptz
  deleted_by String?

  quiz Quiz @relation(fields: [quiz_id], references: [id], onDelete: Cascade)

  @@unique([program, day_index], map: "daily_tasks_program_day_index_key")
  @@unique([program, year_level, day_index], map: "daily_tasks_program_year_day_unique")
  @@index([program, year_level, day_index], map: "idx_daily_tasks_program_year_day")
  @@index([deleted_at], map: "daily_tasks_deleted_at_idx")
  @@index([deleted_at], map: "idx_daily_tasks_deleted_at")
  @@map("daily_tasks")
}

model ExamArchivePdf {
  id           String   @id @default(uuid())
  quiz_id      String   @unique
  pdf_url      String
  generated_at DateTime @default(now()) @db.Timestamptz

  quiz Quiz @relation(fields: [quiz_id], references: [id], onDelete: Cascade)

  @@map("exam_archive_pdfs")
}

enum NoteTier {
  free
  premium
}

model Note {
  id         String   @id @default(uuid())
  created_at DateTime @default(now()) @db.Timestamptz
  updated_at DateTime @default(now()) @db.Timestamptz

  title             String
  description       String?
  subject           String   @default("general")
  tier              NoteTier @default(free)
  file_path         String?
  file_mime         String?
  preview_file_path String?
  preview_file_mime String?
  price             Decimal  @default(0)
  discount_price    Decimal  @default(0)
  is_published      Boolean  @default(true)

  download_count Int @default(0)

  // relations
  note_purchases NotePurchase[]
  packages       Package[]

  @@map("notes")
}

enum NotePurchaseStatus {
  pending
  paid
  refunded
  rejected
  failed
}

model NotePurchase {
  id         String   @id @default(uuid())
  created_at DateTime @default(now()) @db.Timestamptz
  updated_at DateTime @updatedAt @db.Timestamptz

  user_id        String
  note_id        String
  amount         Decimal            @default(0)
  sender_phone   String
  transaction_id String
  payment_method String
  status         NotePurchaseStatus @default(pending)

  reviewed_note String?
  reviewed_by   String?
  reviewed_at   DateTime? @db.Timestamptz

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)
  note Note @relation(fields: [note_id], references: [id], onDelete: Cascade)

  @@index([user_id], map: "idx_np_user")
  @@index([note_id], map: "idx_np_note")
  @@index([status], map: "idx_np_status")
  @@map("note_purchases")
}

model NoteTag {
  id            String       @id @default(uuid())
  slug          String       @unique(map: "note_tags_slug_key")
  label_bn      String
  program       PkgProgram?
  track         PkgTrack?
  created_at    DateTime?    @default(now()) @db.Timestamptz
  note_tag_maps NoteTagMap[]

  @@map("note_tags")
}

model NoteTagMap {
  note_id String
  tag_id  String

  tag NoteTag @relation(fields: [tag_id], references: [id], onDelete: Cascade)

  @@id([note_id, tag_id])
  @@map("note_tag_map")
}

model DownloadEvent {
  id              String              @id @default(uuid())
  user_id         String?
  content_type    DownloadContentType
  content_id      String
  content_title   String?
  program         String?
  file_path       String?
  file_size_bytes BigInt?
  source          String?
  client          String?
  session_key     String?
  downloaded_at   DateTime            @default(now()) @db.Timestamptz

  user User? @relation(fields: [user_id], references: [id], onDelete: SetNull)

  @@unique([user_id, content_type, content_id, session_key], map: "download_events_dedupe")
  @@index([content_type, content_id, downloaded_at(sort: Desc)], map: "download_events_content_idx")
  @@index([user_id, downloaded_at(sort: Desc)], map: "download_events_user_idx")
  @@index([downloaded_at(sort: Desc)], map: "download_events_time_idx")
  @@map("download_events")
}

enum FileStatus {
  PENDING
  ATTACHED
}

model FileUpload {
  id         String     @id @default(uuid())
  url        String     @unique
  folder     String
  file_path  String
  status     FileStatus @default(PENDING)
  created_at DateTime   @default(now()) @db.Timestamptz
  updated_at DateTime   @updatedAt @db.Timestamptz

  @@index([status, created_at], map: "idx_file_upload_status_created")
  @@map("file_uploads")
}

