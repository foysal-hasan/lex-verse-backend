// Response Model (Stores user answers for quiz/question bank items)
model Response {
  id               String   @id @default(uuid())
  quiz_id          String?
  user_id          String?
  question_id      String?
  selected_answer  String?
  is_correct       Boolean?
  created_at       DateTime @default(now()) @db.Timestamptz
  question_bank_id String?
  package_id       String?

  // Relations
  package Package? @relation(fields: [package_id], references: [id], onDelete: SetNull)
  user    User?    @relation(fields: [user_id], references: [id], onDelete: SetNull)
  quiz    Quiz?    @relation(fields: [quiz_id], references: [id], onDelete: SetNull)

  @@index([question_bank_id], map: "responses_qb_idx")
  @@index([user_id, quiz_id, package_id], map: "responses_user_quiz_pkg_idx")
  @@index([quiz_id, package_id], map: "responses_quiz_pkg_idx")
  @@index([quiz_id, user_id], map: "idx_responses_quiz_user")
  @@map("responses")
}

// BarResponse Model (Stores Bar Exam response analytics)
model BarResponse {
  id               String   @id @default(uuid())
  user_id          String?
  quiz_id          String
  question_id      String
  selected_answer  String
  is_correct       Boolean  @default(false)
  created_at       DateTime @default(now()) @db.Timestamptz
  question_bank_id String?
  package_id       String?

  // Relations
  package Package? @relation(fields: [package_id], references: [id], onDelete: SetNull)
  user    User?    @relation(fields: [user_id], references: [id], onDelete: SetNull)
  quiz    Quiz     @relation(fields: [quiz_id], references: [id], onDelete: Cascade)

  @@index([question_bank_id], map: "bar_responses_qb_idx")
  @@index([user_id, quiz_id, package_id], map: "bar_responses_user_quiz_pkg_idx")
  @@index([quiz_id, package_id], map: "bar_responses_quiz_pkg_idx")
